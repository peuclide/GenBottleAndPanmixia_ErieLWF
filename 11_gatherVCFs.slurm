#SBATCH -A peuclide
#SBATCH -N 1
#SBATCH -n 48
#SBATCH -t 48:00:00
#SBATCH --mail-user=peuclide@purdue.edu
#SBATCH --output=/scratch/negishi/peuclide/Erie_WH_2024/output/GatherVcfs%A_%a.out
