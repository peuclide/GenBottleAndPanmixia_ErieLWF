geom_line(linewidth = 1)+
scale_x_continuous(breaks = c(1850, 1875, 1900, 1925, 1950, 1975, 2000, 2025))+
theme_classic()+
labs(y="Catch (Millions of Lbs)")+
theme(text=element_text(size = 16))
