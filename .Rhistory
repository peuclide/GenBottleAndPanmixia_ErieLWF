dat <- read.csv("./commercial_worksheet_Erie.csv")
View(dat)
library(tidyverse)
ggplot(dat, aes(x=Year, y = Grand.Total))+
geom_line()
ggplot(dat, aes(x=Year, y = Grand.Total))+
geom_line()
ggplot(dat, aes(x=Year, y = Grand.Total))+
geom_line()+
theme_classic()
ggplot(dat, aes(x=Year, y = Grand.Total))+
geom_line(linewidth = 3)+
theme_classic()
ggplot(dat, aes(x=Year, y = Grand.Total))+
geom_line(linewidth = 3)+
theme_classic()+
theme(text=element_text(size = 14))
ggplot(dat, aes(x=Year, y = Grand.Total))+
geom_line(linewidth = 3)+
scale_x_continuous(breaks = c(1850, 1875, 1900, 1925, 1950, 1975, 2000, 2025))+
theme_classic()+
labs(y="Catch (Millions of Lbs)")
